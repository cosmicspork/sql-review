# sql-review connection settings. Copy to .env (gitignored) and fill in.
# Process-environment variables override these. With --profile NAME, a
# NAME_-prefixed key (e.g. QA_DB_HOST) wins over the bare key.

DB_BACKEND=oracle
DB_HOST=
DB_PORT=
DB_SERVICE=
# The read-only account. Reads always run on it: it is the boundary.
DB_USER=
DB_PASSWORD=
DB_FETCH_LIMIT=1000

# The write account, used only to apply a proposed write (never to preview
# one), and how long reading a write's rows at propose may take, in seconds.
# The write account is never read under --read-only.
# DB_WRITE_USER=
# DB_WRITE_PASSWORD=
# DB_PREVIEW_TIMEOUT=10

# Extra profiles in the same file, selected with --profile qa / --profile tst:
# QA_DB_HOST=
# QA_DB_PORT=
# QA_DB_SERVICE=
# QA_DB_USER=
# QA_DB_PASSWORD=

# SQL Server:
# DB_BACKEND=mssql
# DB_HOST=analytics-prd.example.edu
# DB_PORT=1433
# DB_DATABASE=SomeDatabase
# DB_USER=
# DB_PASSWORD=
# Skip certificate checks (a self-signed server). Default: false.
# DB_TRUST_SERVER_CERTIFICATE=false

# SQLite (the path goes in DB_SERVICE / DB_DATABASE; default :memory:):
# DB_BACKEND=sqlite
# DB_DATABASE=/path/to/file.db

# Or bypass the discrete keys entirely with a full URL:
# DATABASE_URL=oracle+oracledb://user:pass@host:1521/?service_name=PRD
